# ==============================================================================
# 展惠进销存（zhanhui-jxc）环境变量配置模板
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# ==============================================================================

# 运行环境：development | test | production
NODE_ENV=development

# 服务监听端口（1-65535 整数，默认 7741）
PORT=7741

# 服务绑定地址（默认 127.0.0.1 仅本机；公网/容器部署可设为 0.0.0.0）
# 注意：当 ORANGE_BIND 非本机回环地址时，必须同时配置强随机 ORANGE_JWT_SECRET
ORANGE_BIND=127.0.0.1

# 数据目录（SQLite 库文件、备份目录、runtime 密钥文件所在位置；默认 ./data）
ORANGE_DATA_DIR=./data

# 可选：显式指定 SQLite 数据库文件路径（默认 <ORANGE_DATA_DIR>/huimin-clone.db）
# ORANGE_DB_PATH=/app/data/huimin-clone.db

# JWT/HMAC 令牌签名密钥（强烈建议 >= 32 位随机字符，可用以下命令生成）：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未设置时：
#   - 若 NODE_ENV=production 或 ORANGE_REQUIRE_SECRET=1 或非本机绑定：启动快速失败
#   - 若仅本机开发/桌面版：自动生成 256-bit 随机密钥并持久化到 <ORANGE_DATA_DIR>/.jwt-secret
ORANGE_JWT_SECRET=

# 是否强制要求显式配置 ORANGE_JWT_SECRET（1=开启；非本机/生产环境自动强制）
ORANGE_REQUIRE_SECRET=0

# Host 头白名单附加域名（逗号分隔，用于内网穿透或反向代理域名访问）
# 例：ORANGE_ALLOW_HOSTS=jxc.example.com,erp.example.com
ORANGE_ALLOW_HOSTS=

# 是否在 HTTPS 反向代理后启用 Cookie Secure 属性（1=开启；auto=当 X-Forwarded-Proto=https 时开启）
ORANGE_COOKIE_SECURE=0

# 是否信任反向代理头（如 X-Forwarded-For / X-Forwarded-Proto；0=关闭，1..20=受信任的反向代理跳数）
ORANGE_TRUST_PROXY=0

# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info

# 日志输出格式：pretty（开发可读）| json（生产结构化 JSON，默认 production 下 json、其余 pretty）
LOG_FORMAT=pretty

# 自动备份保留份数（默认 30，范围 1-365）
BACKUP_KEEP_COUNT=30
